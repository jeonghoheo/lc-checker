generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocumentSet {
  id               String     @id @default(uuid())
  createdAt        DateTime   @default(now())
  presentationDate DateTime?  @db.Date
  documents        Document[]
  checkRuns        CheckRun[]
}

model Document {
  id           String      @id @default(uuid())
  setId        String
  set          DocumentSet @relation(fields: [setId], references: [id])
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  docType      String?
  extractedData Json?
  uploadedAt   DateTime    @default(now())
}

model CheckRun {
  id            String        @id @default(uuid())
  documentSetId String
  documentSet   DocumentSet   @relation(fields: [documentSetId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  results       CheckResult[]
}

model CheckResult {
  checkRunId String
  checkRun   CheckRun @relation(fields: [checkRunId], references: [id], onDelete: Cascade)
  ruleNo     Int
  status     String
  detail     Json

  @@id([checkRunId, ruleNo])
}
